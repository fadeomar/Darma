# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local source archive / backup artifacts
src.zip
src.backup-*/

# scratch verification pages produced while building tools/loaders
tmp-*.html
public/tmp-*.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


neon.dump
neon.sql
prisma/migrations_backup/

# database dumps & explorer migration backups (NEVER commit — kept in a secure dir outside git)
/migration-backups/
*.dump
*.sql
*.sql.gz
*.backup
*.pgpass
SHA256SUMS

# generated external link-health reports
/ATLAS_LINK_HEALTH*.md
/ATLAS_LINK_HEALTH*.json

# generated audit reports (rebuilt by npm run atlas:quality)
/ATLAS_GOVERNANCE_AUDIT.md
/ATLAS_GOVERNANCE_AUDIT.json
/EDITORIAL_CONTENT_AUDIT.md
/EDITORIAL_CONTENT_AUDIT.json
/LEARNING_PATHS_AUDIT.md
/LEARNING_PATHS_AUDIT.json
/RESOURCE_LIBRARY_AUDIT.md
/RESOURCE_LIBRARY_AUDIT.json
/SEO_AUTHORITY_AUDIT.md
/SEO_AUTHORITY_AUDIT.json
/TECH_ATLAS_AUDIT.md
/TECH_ATLAS_AUDIT.json
/VISUAL_EXPERIENCE_AUDIT.md
/VISUAL_EXPERIENCE_AUDIT.json
