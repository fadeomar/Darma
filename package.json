{
  "name": "darma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:admin": "ts-node prisma/seed-admin.ts",
    "seed:element": "tsx prisma/seed-glass-card.ts",
    "check:tools": "tsx scripts/check-tools-registry.ts",
    "test": "vitest run",
    "generate:css-loaders": "tsx scripts/css-loaders/generate-css-loaders.ts",
    "audit:css-loaders": "tsx scripts/css-loaders/generate-css-loaders.ts --audit-duplicates",
    "audit:design": "node scripts/design-refactor-audit.mjs",
    "favicon:check": "tsx scripts/check-favicon-url.ts",
    "content:export:explorer": "tsx scripts/content/export-explorer-from-db.ts",
    "content:validate:explorer-export": "tsx scripts/content/validate-explorer-export.ts",
    "content:scan:explorer-secrets": "tsx scripts/content/scan-explorer-secrets.ts",
    "content:test:explorer": "vitest run scripts/content",
    "content:compare:explorer-read-sources": "tsx scripts/content/compare-explorer-read-sources.ts",
    "content:build:explorer-catalog": "tsx scripts/content/build-explorer-catalog.ts",
    "content:validate:explorer-catalog": "tsx scripts/content/validate-explorer-catalog.ts",
    "content:check:explorer-github": "tsx scripts/content/check-explorer-github-source.ts",
    "content:compare:explorer-admin-sources": "tsx scripts/content/compare-explorer-admin-sources.ts",
    "resources:build": "node scripts/resources/build-resource-catalog.mjs",
    "resources:audit": "node scripts/resources/audit-resource-catalog.mjs",
    "resources:audit:verbose": "node scripts/resources/audit-resource-catalog.mjs --verbose",
    "resources:sync-icons": "node scripts/resources/sync-resource-icons.mjs",
    "learning-paths:audit": "node scripts/learning-paths/audit-learning-paths.mjs",
    "learning-paths:audit:verbose": "node scripts/learning-paths/audit-learning-paths.mjs --verbose",
    "atlas:audit": "npm run resources:audit && npm run learning-paths:audit && npm run tech-atlas:audit",
    "tech-atlas:audit": "node scripts/tech-atlas/audit-tech-atlas.mjs",
    "tech-atlas:audit:verbose": "node scripts/tech-atlas/audit-tech-atlas.mjs --verbose",
    "atlas:governance": "node scripts/atlas/audit-governance.mjs",
    "atlas:quality": "npm run atlas:audit && npm run atlas:governance && npm run seo:authority && npm run ui:motion:audit",
    "atlas:links": "node scripts/atlas/check-external-links.mjs",
    "atlas:links:sample": "node scripts/atlas/check-external-links.mjs --limit=25 --report=ATLAS_LINK_HEALTH_SAMPLE.md --json=ATLAS_LINK_HEALTH_SAMPLE.json",
    "editorial:audit": "node scripts/editorial/audit-editorial-content.mjs",
    "seo:audit": "node scripts/seo/audit-seo-authority.mjs",
    "seo:authority": "npm run editorial:audit && npm run seo:audit",
    "ui:motion:audit": "node scripts/ui/audit-visual-experience.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.5.0",
    "@tiptap/extension-color": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-text-style": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "colorjs.io": "^0.5.2",
    "dexie": "^4.4.4",
    "dompurify": "^3.2.4",
    "emoji-picker-react": "^4.19.1",
    "framer-motion": "^12.6.0",
    "gsap": "^3.15.0",
    "jose": "^6.1.3",
    "js-cookie": "^3.0.5",
    "jszip": "^3.10.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.484.0",
    "next": "^16.1.4",
    "phaser": "^4.2.0",
    "prisma": "^6.5.0",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "5.5.0",
    "react-select": "^5.10.1",
    "react-syntax-highlighter": "^15.6.1",
    "styled-components": "^6.1.16",
    "tailwind-merge": "^3.1.0",
    "tinycolor2": "^1.6.0",
    "turndown": "^7.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/tinycolor2": "^1.4.6",
    "@types/turndown": "^5.0.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
